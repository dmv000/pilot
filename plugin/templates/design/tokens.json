{
  "$description": "Design tokens: the single source of truth for design values (W3C design-tokens format: each leaf has $type and $value). Starter values are neutral and pass WCAG AA contrast; /pilot:design replaces them with the project's own.",
  "$pilot": {
    "contrastPairs": [
      { "fg": "color.text", "bg": "color.bg", "min": 4.5 },
      { "fg": "color.text", "bg": "color.surface", "min": 4.5 },
      { "fg": "color.text-muted", "bg": "color.bg", "min": 4.5 },
      { "fg": "color.on-primary", "bg": "color.primary", "min": 4.5 },
      { "fg": "color.danger", "bg": "color.bg", "min": 4.5 },
      { "fg": "color.border", "bg": "color.bg", "min": 3 },
      { "fg": "color.focus", "bg": "color.bg", "min": 3 }
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#ffffff" },
    "surface": { "$type": "color", "$value": "#f5f6f8" },
    "text": { "$type": "color", "$value": "#16181d" },
    "text-muted": { "$type": "color", "$value": "#545b66" },
    "primary": { "$type": "color", "$value": "#1d4ed8" },
    "on-primary": { "$type": "color", "$value": "#ffffff" },
    "danger": { "$type": "color", "$value": "#b42318" },
    "border": { "$type": "color", "$value": "#8a919c" },
    "focus": { "$type": "color", "$value": "#1d4ed8" }
  },
  "font": {
    "family": {
      "base": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"] }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.25rem" },
      "xl": { "$type": "dimension", "$value": "1.75rem" },
      "2xl": { "$type": "dimension", "$value": "2.25rem" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "0.25rem" },
    "sm": { "$type": "dimension", "$value": "0.5rem" },
    "md": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.5rem" },
    "xl": { "$type": "dimension", "$value": "2.5rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" }
  },
  "shadow": {
    "raised": { "$type": "shadow", "$value": "0 1px 3px rgba(0, 0, 0, 0.12)" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" }
    }
  }
}
