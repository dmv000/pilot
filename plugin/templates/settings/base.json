{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "pilot:direct",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh pr create *)",
      "Bash(git push *)",
      "Bash(npm publish *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)"
    ]
  }
}
